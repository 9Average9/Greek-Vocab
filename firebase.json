{
  "hosting": {
    "target": "rhemaDesktop",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "scripts/**",
      "firebase-debug.log",
      "firestore.rules",
      "firestore.indexes.json",
      "storage.rules",
      "README-desktop.md"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
