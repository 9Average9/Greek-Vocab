rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles — anyone can read, owner can write anything,
    // any authenticated user may update only the social-graph fields
    // (so friend requests/accepts/declines work across users)
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['friendRequestsIn', 'friendRequestsOut', 'friends', 'updatedAt']);

      match /habits/{habitId} {
        allow read: if request.auth != null
          && (request.auth.uid == uid
              || request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.friends);
        allow create, update, delete: if request.auth != null
          && request.auth.uid == uid;

        match /entries/{entryId} {
          allow read: if request.auth != null
            && (request.auth.uid == uid
                || request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.friends);
          allow create, update, delete: if request.auth != null
            && request.auth.uid == uid;
        }
      }

      match /habitEncouragements/{sendId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == uid;
      }

      match /merciesJournal/{entryId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == uid;
      }

      // Rhema verse highlights/notes — private to the owner.
      match /rhemaMarks/{markId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == uid;
      }

      // Rhema saved verse comparisons (trails) — private to the owner.
      match /rhemaTrails/{trailId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == uid;
      }

      match /habitReminderSlots/{slotId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == uid;
      }
    }

    // Leaderboards — anyone can read, only owner can write their own entry
    match /xp_board/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /scholar_board/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /consistency_board/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Username / display name uniqueness checks
    match /usernames/{name} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /displayNames/{name} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Push notifications — recipient can read their own, any auth user can write
    match /encouragements/{uid}/messages/{msgId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null;
    }

    // Community posts — visible only to the post audience.
    // Authors can create their own posts, audience members can react,
    // and authors can soft-delete their own posts.
    match /communityPosts/{postId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.audienceUids;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.auth.uid in request.resource.data.audienceUids;
      allow update: if request.auth != null && (
        // Friends in the audience can update lightweight social fields.
        (request.auth.uid in resource.data.audienceUids &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['reactions', 'prayers', 'commentCount'])) ||
        // Author can share recent posts with a newly accepted friend.
        (request.auth.uid == resource.data.authorUid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['audienceUids'])) ||
        // Author can soft-delete the post.
        (request.auth.uid == resource.data.authorUid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['isActive', 'deletedAt']))
      );
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.authorUid;
    }

    match /communityPosts/{postId}/comments/{commentId} {
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/communityPosts/$(postId)).data.audienceUids;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/communityPosts/$(postId)).data.audienceUids;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.authorUid;
    }

    // Studies — any authenticated user can read all studies (for the community board).
    // Only the creator can create a study (creatorUid must match auth uid).
    // Any collaborator can update the study document (session timestamps, rhema positions, etc.).
    // Only the creator can delete.
    match /merciesPosts/{postId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.audienceUids;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.auth.uid in request.resource.data.audienceUids;
      allow update: if request.auth != null && (
        (request.auth.uid in resource.data.audienceUids &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['reactions', 'commentCount'])) ||
        (request.auth.uid == resource.data.authorUid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['journalSavedBy'])) ||
        (request.auth.uid == resource.data.authorUid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['audienceUids'])) ||
        (request.auth.uid == resource.data.authorUid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['isActive', 'deletedAt']))
      );
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.authorUid;
    }

    match /merciesPosts/{postId}/comments/{commentId} {
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/merciesPosts/$(postId)).data.audienceUids;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/merciesPosts/$(postId)).data.audienceUids;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.authorUid;
    }

    match /studies/{studyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.creatorUid == request.auth.uid
        && request.auth.uid in request.resource.data.collaboratorUids;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.collaboratorUids ||
        request.auth.uid == resource.data.creatorUid ||
        // Any auth user can add themselves to pendingCollaboratorUids (collab request)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingCollaboratorUids']) &&
         request.auth.uid in request.resource.data.pendingCollaboratorUids) ||
        // Invitee can accept their own invite (moves self from pending → collaborator)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collaboratorUids', 'pendingCollaboratorUids']) &&
         request.auth.uid in resource.data.pendingCollaboratorUids &&
         !(request.auth.uid in resource.data.collaboratorUids))
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorUid;
    }

    // Study subcollections — any collaborator can read/write notes, saved verses, and word log
    match /studies/{studyId}/notes/{noteId} {
      allow read: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/studies/$(studyId)).data.collaboratorUids;
      allow write: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/studies/$(studyId)).data.collaboratorUids;
    }
    match /studies/{studyId}/savedVerses/{verseId} {
      allow read: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/studies/$(studyId)).data.collaboratorUids;
      allow write: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/studies/$(studyId)).data.collaboratorUids;
    }
    match /studies/{studyId}/wordLog/{wordId} {
      allow read: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/studies/$(studyId)).data.collaboratorUids;
      allow write: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/studies/$(studyId)).data.collaboratorUids;
    }
    match /studies/{studyId}/trails/{trailId} {
      allow read: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/studies/$(studyId)).data.collaboratorUids;
      allow write: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/studies/$(studyId)).data.collaboratorUids;
    }
    match /studies/{studyId}/structures/{structureId} {
      allow read: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/studies/$(studyId)).data.collaboratorUids;
      allow write: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/studies/$(studyId)).data.collaboratorUids;
    }
    match /studies/{studyId}/entries/{entryId} {
      allow read: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/studies/$(studyId)).data.collaboratorUids;
      allow write: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/studies/$(studyId)).data.collaboratorUids;
    }

    // Group calendar events -- creator owns event details, participants can RSVP and attach their own sync state.
    match /events/{eventId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantUids;

      allow create: if request.auth != null
        && request.resource.data.creatorUid == request.auth.uid
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.isActive == true
        && request.resource.data.keys().hasAll([
          'title', 'date', 'time', 'creatorUid', 'creatorName',
          'invitees', 'participantUids', 'reminders', 'sentReminders',
          'googleCalIds', 'isActive', 'timezone', 'createdAt', 'updatedAt'
        ]);

      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.creatorUid == resource.data.creatorUid
        && (
          // Creator may edit/cancel the event and reset reminder state after meaningful changes.
          (request.auth.uid == resource.data.creatorUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'date', 'time', 'timezone', 'location', 'description',
              'eventAtMs', 'invitees', 'participantUids', 'reminders', 'sentReminders',
              'isActive', 'updatedAt'
            ]))
          ||
          // Invitees may RSVP. The current array shape cannot prove "only my row"
          // in rules, but this keeps invitee writes away from event details.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitees', 'updatedAt'])
            && request.resource.data.participantUids == resource.data.participantUids)
          ||
          // Participants may store calendar sync ids without changing event details.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['googleCalIds', 'updatedAt'])
            && request.resource.data.participantUids == resource.data.participantUids)
        );

      // No hard deletes -- creator cancellation is a soft update to isActive:false.
      allow delete: if false;
    }

    // Google Calendar refresh tokens are server-only. Cloud Functions uses Admin SDK
    // and bypasses rules; the client should only use callable functions.
    match /googleCalendarTokens/{uid} {
      allow read, write: if false;
    }

  }
}
